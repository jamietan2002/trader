# ============================================================================
# Swing Trading AI — Environment Configuration Template
# Copy to `.env` (`cp .env.example .env`) and customize as needed.
# ============================================================================

# Strictly enforced: MUST be "paper". Any non-paper value raises LiveTradingProhibitedError.
TRADING_MODE=paper
INITIAL_CAPITAL_USD=100000.0
BASE_CURRENCY=USD
BENCHMARK_TICKER=SPY

# Swing holding period constraints (trading days)
HOLDING_PERIOD_MIN_DAYS=3
HOLDING_PERIOD_MAX_DAYS=15

# Timezone configuration
MARKET_TIMEZONE=America/New_York
OPERATOR_TIMEZONE=Asia/Singapore

# Database URL (defaults to local SQLite `sqlite:///data/swing_trader.db` if empty;
# supports PostgreSQL `postgresql://trader:trader@postgres:5432/swing_trader` in Docker)
DATABASE_URL=

# Market Data Provider: alpaca | local_seeded | polygon | fmp | finnhub
# Defaults to alpaca (automatically falls back to local_seeded if ALPACA_API_KEY is not set)
MARKET_DATA_PROVIDER=alpaca

# Optional Market Data API Credentials (never committed or logged)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
POLYGON_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
SEC_EDGAR_USER_AGENT="SwingTradingResearchPlatform research@example.com"

# LLM Provider Abstraction: deterministic_research | gemini | openai
LLM_PROVIDER=deterministic_research
LLM_MODEL=gemini-2.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=

# Web Dashboard & API Server
API_HOST=127.0.0.1
API_PORT=8080

